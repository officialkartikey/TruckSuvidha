# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/trucksuvidha_gps

# JWT Configuration
JWT_SECRET=replace_this_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Device Settings
# Device offline threshold in seconds (default: 120s / 2 minutes)
DEVICE_OFFLINE_TIMEOUT_SECONDS=120

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
DEVICE_RATE_LIMIT_MAX_REQUESTS=600
